# Copy to .env.local and fill in. Never commit real values.

# MongoDB connection string (Atlas or self-hosted). The database name in the URI is used,
# or MONGODB_DB if the URI has none.
MONGODB_URI=mongodb://localhost:27017/resplendent_cosmetics
# MONGODB_DB=resplendent_cosmetics

# Public origin used in sitemap.xml / robots.txt (defaults to https://www.resplendentcosmetics.com)
# NEXT_PUBLIC_SITE_URL=https://www.resplendentcosmetics.com
